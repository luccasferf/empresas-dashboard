# Copie este arquivo para ".env" e preencha com suas credenciais.
# NUNCA commite o .env de verdade (ele já está no .gitignore).

# Encontrado em: Workspace Databricks > SQL Warehouses > seu warehouse > Connection details
DATABRICKS_SERVER_HOSTNAME=xxxxxxxxxxxxx.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx

# Gerado em: User Settings > Developer > Access tokens > Generate new token
DATABRICKS_TOKEN=dapi_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tabela de origem, no formato catalog.schema.tabela
# gold.powerbi_gestao_empresas: ~22,2M linhas, agregada por UF/município/CNAE/porte/
# situação cadastral/natureza jurídica/ano, já com qtd_empresas, qtd_mei, qtd_simples,
# qtd_estabelecimentos etc. prontos — cobre todos os KPIs/gráficos do dashboard.
DATABRICKS_TABLE=catalog.schema.tabela
